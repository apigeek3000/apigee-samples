# Caddy config for the superdemo frontend container.
# $PORT          — injected by Cloud Run (default 8080).
# $BACKEND_HOST  — backend Cloud Run host (no scheme), set by deploy-superdemo-app.sh.
{
	# Cloud Run terminates TLS at the edge; serve plain HTTP inside the container.
	auto_https off
	admin off
}

:{$PORT:8080} {
	encode gzip

	# Reverse-proxy the API to the backend service. The browser sees this as a
	# same-origin /api/* path, so no CORS is involved. Rewrite the Host header to
	# the backend's so Cloud Run routes to the right service, and use TLS upstream.
	handle /api/* {
		reverse_proxy https://{$BACKEND_HOST} {
			header_up Host {$BACKEND_HOST}
		}
	}

	# Everything else is the static SPA. Unknown paths fall back to index.html so
	# client-side routing works.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
